{
  "name": "gestor-delivery-saas",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema SaaS de gestão de delivery multi-tenant",
  "scripts": {
    "dev:api": "pnpm -C apps/api dev",
    "dev:web-tenant": "pnpm --filter @gestor/web-tenant dev",
    "dev:web-admin": "pnpm --filter @gestor/web-admin dev",
    "dev:web-storefront": "pnpm --filter @gestor/web-storefront dev",
    "dev:all": "pnpm -r --parallel --filter @gestor/api --filter @gestor/web-tenant --filter @gestor/web-admin --filter @gestor/web-storefront run dev",
    "build": "pnpm -r run build",
    "build:api": "pnpm --filter @gestor/api... build",
    "build:web-tenant": "pnpm --filter @gestor/web-tenant build",
    "build:web-admin": "pnpm --filter @gestor/web-admin build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm exec tsc -p apps/api/tsconfig.build.json --noEmit && pnpm --filter @gestor/web-tenant exec tsc --noEmit && pnpm --filter @gestor/web-admin exec tsc --noEmit && pnpm --filter @gestor/web-delivery exec tsc --noEmit && pnpm --filter @gestor/web-storefront exec tsc -p tsconfig.app.json --noEmit && pnpm --filter @gestor/web-storefront exec tsc -p tsconfig.node.json --noEmit",
    "prisma:validate": "pnpm -C apps/api exec prisma validate",
    "clean": "pnpm -r run clean",
    "db:generate": "pnpm -C apps/api prisma:generate",
    "db:migrate": "pnpm -C apps/api prisma:migrate",
    "db:seed": "pnpm -C apps/api prisma:seed",
    "db:studio": "pnpm -C apps/api prisma:studio",
    "start:api": "pnpm --filter @gestor/api start:prod",
    "start:web-tenant": "pnpm --filter @gestor/web-tenant preview",
    "start:web-admin": "pnpm --filter @gestor/web-admin preview",
    "start:web-storefront": "pnpm --filter @gestor/web-storefront preview",
    "check:no-any": "node scripts/check-no-any.js",
    "check:theme:critical": "node scripts/check-theme-hardcoded-classes.js --critical",
    "check:theme:report": "node scripts/check-theme-hardcoded-classes.js --report",
    "check:theme:baseline": "node scripts/check-theme-hardcoded-classes.js --baseline",
    "check:boundaries": "node scripts/check-package-boundaries.js",
    "check:theme:write-baseline": "node scripts/check-theme-hardcoded-classes.js --report --write-baseline",
    "check:theme": "pnpm check:theme:critical",
    "smoke:p1": "pnpm -C apps/api smoke:p1",
    "smoke:media": "pnpm -C apps/api smoke:media",
    "qa:visual": "ts-node --project apps/api/tsconfig.json -r tsconfig-paths/register scripts/qa-visual.ts",
    "qa:visual:update": "ts-node --project apps/api/tsconfig.json -r tsconfig-paths/register scripts/qa-visual.ts"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "~4.2.0",
    "turbo": "2.7.4",
    "typescript": "~5.5.4"
  }
}