{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "noEmit": true,
    "jsx": "react-jsx",
    "experimentalDecorators": true, 
    "emitDecoratorMetadata": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "rootDir": "../../",
    "paths": {
      "@/*": ["./src/*"],
      "@gestor/types": ["../../packages/types/src"],
      "@gestor/core": ["../../packages/core/src"],
      "@gestor/utils": ["../../packages/utils/src"],
      "@gestor/auth": ["../../packages/auth/src"],
      "@gestor/config": ["../../packages/config/src"],
      "@gestor/ui": ["../../packages/ui/src"]
    }
  },
  "include": [
    "src",
    "../../packages/types/src",
    "../../packages/core/src",
    "../../packages/utils/src",
    "../../packages/auth/src",
    "../../packages/config/src",
    "../../packages/ui/src"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
