# Otimizações para reduzir consumo de memória durante o deploy
# https://docs.npmjs.com/cli/v9/using-npm/config

# Reduzir uso de memória do npm durante instalações
fetch-retries=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Limitar número de operações simultâneas
maxsockets=50

# Otimizar cache
prefer-offline=true
