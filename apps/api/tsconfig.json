{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "../../",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2021",
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "incremental": false,
    "composite": false,
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@gestor/types": ["../../packages/types/src"],
      "@gestor/core": ["../../packages/core/src"],
      "@gestor/utils": ["../../packages/utils/src"],
      "@gestor/auth": ["../../packages/auth/src"],
      "@gestor/config": ["../../packages/config/src"],
      "@gestor/ui": ["../../packages/ui/src"]
    }
  },
  "include": [
    "src/**/*",
    "../../packages/types/src",
    "../../packages/core/src",
    "../../packages/utils/src",
    "../../packages/auth/src",
    "../../packages/config/src",
    "../../packages/ui/src"
  ],
  "exclude": ["node_modules", "dist", "test"]
}
