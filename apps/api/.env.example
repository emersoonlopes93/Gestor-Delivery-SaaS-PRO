# =========================================================================
# GESTOR DELIVERY SAAS PRO - CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (API)
# =========================================================================

# -------------------------------------------------------------------------
# 1. CONFIGURAÇÕES GERAIS DO PROJETO (OBRIGATÓRIAS)
# -------------------------------------------------------------------------
# Ambiente do Node.js (development, production, staging, test)
NODE_ENV=development

# Porta na qual a API irá escutar as requisições HTTP
API_PORT=3333

# Prefixo padrão das rotas da API (ex: /api/v1)
API_PREFIX=/api/v1

# URL pública da API utilizada para expor endpoints e webhooks externamente (opcional em local)
PUBLIC_API_URL=localhost:3333

# -------------------------------------------------------------------------
# 2. BANCO DE DADOS (OBRIGATÓRIO - POSTGRESQL / PRISMA)
# -------------------------------------------------------------------------
# URL de conexão principal com o PostgreSQL (com pooling de conexão)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestor_delivery?schema=public&connect_timeout=30&pool_timeout=30"

# URL de conexão direta (sem pooling), necessária para rodar migrações do Prisma com segurança (Neon/Supabase)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gestor_delivery?schema=public&connect_timeout=30&pool_timeout=30"

# -------------------------------------------------------------------------
# 2.1. BILLING OPERACIONAL / GATEWAY (FASE 4.5+)
# -------------------------------------------------------------------------
# strict: API falha no startup se tabelas billing críticas estiverem ausentes.
# warn: loga erro crítico e continua. off: desativa o preflight.
BILLING_DB_PREFLIGHT=strict

# Mantido desligado até a fase de gateway real.
BILLING_PAYMENTS_ENABLED=false
BILLING_GATEWAY_PROVIDER=manual
BILLING_GATEWAY_MODE=disabled
# Sandbox-only local payment foundation examples:
# BILLING_PAYMENTS_ENABLED=true
# BILLING_GATEWAY_PROVIDER=mock
# BILLING_GATEWAY_MODE=sandbox
# Manual-only payment attempts:
# BILLING_PAYMENTS_ENABLED=true
# BILLING_GATEWAY_PROVIDER=manual
# BILLING_GATEWAY_MODE=manual
# Asaas SaaS billing sandbox only:
# BILLING_PAYMENTS_ENABLED=true
# BILLING_GATEWAY_PROVIDER=asaas
# BILLING_GATEWAY_MODE=sandbox
# ASAAS_BILLING_API_KEY=
ASAAS_BILLING_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_BILLING_WEBHOOK_SECRET=

# -------------------------------------------------------------------------
# 3. SEGURANÇA E AUTENTICAÇÃO (OBRIGATÓRIO - JWT)
# -------------------------------------------------------------------------
# Chave secreta para assinar os Access Tokens JWT (Mínimo de 16 caracteres, use chaves seguras em produção)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-at-least-16-chars

# Chave secreta para assinar os Refresh Tokens JWT (Mínimo de 16 caracteres)
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-at-least-16-chars

# Tempo de expiração do Access Token (ex: 15m, 1h)
JWT_EXPIRES_IN=15m

# Tempo de expiração do Refresh Token (ex: 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# -------------------------------------------------------------------------
# 4. CONTROLE DE TAXA (RATE LIMITER)
# -------------------------------------------------------------------------
# Configuração global de limites de requisição por janela de tempo
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# Limites específicos para rotas de autenticação (evitar brute force)
RATE_LIMIT_AUTH_TTL_SECONDS=60
RATE_LIMIT_AUTH_MAX_REQUESTS=10

# Limites específicos para rotas públicas (como o cardápio digital)
RATE_LIMIT_PUBLIC_TTL_SECONDS=60
RATE_LIMIT_PUBLIC_MAX_REQUESTS=60

# -------------------------------------------------------------------------
# 5. SEGURANÇA CORS (CORS_ORIGINS)
# -------------------------------------------------------------------------
# URLs dos frontends autorizadas a acessar a API separadas por vírgula (sem espaços)
# Exemplo: https://admin.seudominio.com,https://loja.seudominio.com
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# URL pública do frontend (web-storefront). Usada para gerar URLs absolutas
# nos ícones do manifest PWA dinâmico dos tenants.
# Exemplo: https://pedehub.vercel.app
FRONTEND_URL=http://localhost:3000

# -------------------------------------------------------------------------
# 5.1 CACHE E PERFORMANCE
# -------------------------------------------------------------------------
# Tempo de cache para o payload público do storefront (em milissegundos)
# Padrão: 60000 (1 minuto)
STOREFRONT_CACHE_TTL=60000

# -------------------------------------------------------------------------
# 6. CONFIGURAÇÃO DE REDIS (BULLMQ & FILAS)
# -------------------------------------------------------------------------
# O Redis é obrigatório se BULLMQ_ENABLED ou CAMPAIGNS_DISPATCH_ENABLED estiverem ativos.
# Host/Endereço do Redis
REDIS_HOST=localhost

# Porta do Redis (padrão: 6379)
REDIS_PORT=6379

# Senha de autenticação do Redis (deixe em branco se não houver)
REDIS_PASSWORD=

# Utilizar conexão TLS (obrigatório se usar Redis gerenciado como Upstash em produção. Defina true/false)
REDIS_TLS=false

# Ativar BullMQ para filas de tarefas em segundo plano (true/false)
BULLMQ_ENABLED=true

# Ativar o disparador em lote de campanhas e agendamentos (true/false)
CAMPAIGNS_DISPATCH_ENABLED=true

# Ativar varredura periódica de automações (recovery, upsell, recompra, carrinho abandonado)
# true : registra o repeatable job system-automation-scan no BullMQ (executa a cada 5 min)
# false: automações desativadas — use false em ambientes sem Redis ou sem campanha ativa
# Requer CAMPAIGNS_DISPATCH_ENABLED=true e BULLMQ_ENABLED=true
CAMPAIGN_AUTOMATION_ENABLED=true

# -------------------------------------------------------------------------
# 7. DRIVER DE ARMAZENAMENTO (FILES/UPLOADS)
# -------------------------------------------------------------------------
# Driver para uploads: 'local' (salva em disco local) ou 'r2' (Cloudflare R2)
# Em produção (NODE_ENV=production), o driver 'r2' é obrigatório.
STORAGE_DRIVER=local

# Configurações do Cloudflare R2 (Obrigatórias apenas se STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_REGION=auto

# -------------------------------------------------------------------------
# 8. INTELIGÊNCIA ARTIFICIAL (IA E AGENTES - WHATSAPP)
# -------------------------------------------------------------------------
# Provedor padrão/Chaves de APIs de IA para os agentes de atendimento
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (Opcional - Claude)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Google Gemini (Opcional)
# GOOGLE_AI_API_KEY=
# GOOGLE_AI_MODEL=gemini-2.0-flash-lite

# Simulação de digitação no WhatsApp pelo agente IA (true/false)
AI_SIMULATE_TYPING=true
AI_TYPING_MIN_DELAY_MS=1500
AI_TYPING_MAX_DELAY_MS=5000

# -------------------------------------------------------------------------
# 9. INTEGRACÕES DE GEOCODING (GOOGLE MAPS)
# -------------------------------------------------------------------------
# Chave de API do Google Maps para calcular rotas e distância da entrega pelo Agente IA
GOOGLE_MAPS_KEY=

# -------------------------------------------------------------------------
# 10. WHATSAPP CLOUD API (META OFICIAL - OPCIONAL)
# -------------------------------------------------------------------------
# Token de acesso permanente da API do WhatsApp Cloud
WHATSAPP_CLOUD_ACCESS_TOKEN=

# ID do número de telefone configurado no painel Meta Developers
WHATSAPP_CLOUD_PHONE_NUMBER_ID=

# Versão da Graph API da Meta (padrão: v19.0)
WHATSAPP_CLOUD_GRAPH_API_VERSION=v19.0

# Template de mensagem aprovado na Meta para disparos de OTP/Segurança
WHATSAPP_OTP_MESSAGE_TEMPLATE="Seu código de acesso é: {{CODE}}"

# Token de verificação configurado no webhook da Meta Developers para validação
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# -------------------------------------------------------------------------
# 11. MERCADO PAGO (OPCIONAL)
# -------------------------------------------------------------------------
# Segredo do webhook do Mercado Pago para receber notificações de pagamentos PIX/Cartão
MERCADO_PAGO_WEBHOOK_SECRET=

# -------------------------------------------------------------------------
# 11.1 WEBHOOK SECURITY
# -------------------------------------------------------------------------
# Obrigatorio em staging/producao. Deve ser igual ao secret configurado no provedor/workflow.
ASAAS_WEBHOOK_HMAC_SECRET=
ASAAS_WEBHOOK_ALLOW_LEGACY_TOKEN=false
WEBHOOK_REPLAY_WINDOW_SECONDS=300
# Deve permanecer false em producao; habilite true apenas para staging smoke controlado.
WEBHOOK_SECURITY_SMOKE_ENABLED=false

# -------------------------------------------------------------------------
# 12. WEB PUSH NOTIFICATIONS (VAPID)
# -------------------------------------------------------------------------
# Chave pública VAPID gerada para web push
VAPID_PUBLIC_KEY=

# Chave privada VAPID gerada para web push
VAPID_PRIVATE_KEY=

# Email de contato cadastrado na notificação push (ex: mailto:seu-email@dominio.com)
VAPID_SUBJECT=mailto:admin@gestordelivery.com.br

# -------------------------------------------------------------------------
# 13. URLS DE REDIRECIONAMENTO E COMUNICAÇÃO DE FRONTENDS
# -------------------------------------------------------------------------
# URLs finais ou locais dos painéis web
WEB_TENANT_URL=http://localhost:5173
WEB_ADMIN_URL=http://localhost:5174
WEB_STOREFRONT_URL=http://localhost:3000

# -------------------------------------------------------------------------
# 14. DOCUMENTAÇÃO E SWAGGER
# -------------------------------------------------------------------------
# Habilitar interface do Swagger OpenAPI (true/false)
SWAGGER_ENABLED=false

# Rota de acesso da documentação OpenAPI/Swagger (padrão: /docs)
SWAGGER_PATH=/docs

# -------------------------------------------------------------------------
# 15. VARIAVEIS ADICIONAIS USADAS PELO CODIGO E POR ROTINAS OPERACIONAIS
# -------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@gestordelivery.com.br
PRISMA_TX_MAX_WAIT_MS=5000
PRISMA_BASE_MENU_DRAFT_TX_TIMEOUT_MS=20000
ASAAS_BILLING_API_KEY=
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
BILLING_SMOKE_ENABLED=false
SMOKE_ENABLED=false
ALLOW_SMOKE_RESET=false
REDIS_ENABLED=true
REDIS_TLS_REJECT_UNAUTHORIZED=true
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_RECONNECT_BASE_DELAY_MS=500
REDIS_RECONNECT_MAX_DELAY_MS=5000
REDIS_RECONNECT_MAX_ATTEMPTS=3
REDIS_LOG_THROTTLE_MS=60000
REDIS_HEALTH_CACHE_TTL_MS=30000
REDIS_HEALTH_TIMEOUT_MS=1500
FEATURE_WHATSAPP_STATUS_CAMPAIGNS=false
POST_PURCHASE_UPSELL_DELAY_MINUTES=60
MARKETPLACE_IFOOD_WEBHOOK_TOKEN=
MARKETPLACE_SMOKE_ENABLED=false
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_ROOT=
MEDIA_UPLOAD_DIR=
MEDIA_PUBLIC_BASE_URL=
MEDIA_CDN_BASE_URL=
MEDIA_MAX_SIZE_BYTES=
MEDIA_MAX_FILE_SIZE_MB=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
ANTHROPIC_VERSION=2023-06-01
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash-lite
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
VITE_GOOGLE_MAPS_KEY=
