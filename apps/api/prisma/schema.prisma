// ============================================================
// Prisma Schema — Gestor Delivery SaaS
// Phase 1: Foundation
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// TENANT — Multi-tenant root entity
// ============================================================

model Tenant {
  id            String       @id @default(uuid())
  name          String       @db.VarChar(100)
  slug          String       @unique @db.VarChar(60)
  status        TenantStatus @default(active)
  orderSequence Int          @default(0) @map("order_sequence")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Relations
  settings               TenantSettings?
  users                  TenantUser[]
  roles                  TenantRole[]
  categories             ProductCategory[]
  products               Product[]
  complementGroups       ProductComplementGroup[]
  complementItems        ProductComplementItem[]
  productComplementLinks ProductComplementGroupLink[]
  productCombos          ProductCombo[]
  productComboBlocks     ProductComboBlock[]
  productComboBlockItems ProductComboBlockItem[]
  orders                 Order[]
  orderItems             OrderItem[]
  orderItemComplements   OrderItemComplement[]
  orderItemComboSelections OrderItemComboSelection[]
  orderDeliveryAddresses OrderDeliveryAddress[]
  orderTimelines         OrderTimeline[]
  deliveryDrivers        DeliveryDriver[]
  deliveryDriverLocations DeliveryDriverLocation[]
  cashSessions           CashSession[]
  cashMovements          CashMovement[]

  customers              Customer[]
  coupons                Coupon[]
  cashbackTransactions   CashbackTransaction[]

  ingredients                Ingredient[]
  stockMovements             StockMovement[]
  productRecipeIngredients   ProductRecipeIngredient[]
  complementRecipeIngredients ComplementRecipeIngredient[]
  comboRecipeIngredients     ComboRecipeIngredient[]
  goals                      Goal[]
  deliveryRateRules          DeliveryRateRule[]
  deliveryCoverageConfig     DeliveryCoverageConfig?
  moduleAccess              TenantModuleAccess[]

  optionGroups             OptionGroup[]
  optionItems              OptionItem[]
  productOptionGroupLinks  ProductOptionGroupLink[]
  catalogPublications      CatalogPublication[]
  catalogAvailabilityRules CatalogAvailabilityRule[]
  comboSlots               ComboSlot[]
  comboSlotAllowedItems    ComboSlotAllowedItem[]

  @@map("tenants")
}

enum TenantStatus {
  active
  inactive
  suspended
  trial
}

enum CatalogProductType {
  simple
  configurable
  combo
}

enum OptionSelectionType {
  single
  multiple
  quantity
}

enum PriceImpactType {
  none
  fixed
  replace
  percentage
}

enum PricingAxis {
  primary
  secondary
}

enum CatalogPublicationStatus {
  draft
  published
}

enum CatalogOperationalStatus {
  active
  inactive
  hidden
  sold_out_manual
}

enum CatalogSalesChannel {
  storefront_delivery
  storefront_pickup
  pos
}

model OptionGroup {
  id            String              @id @default(uuid())
  tenantId      String              @map("tenant_id")
  name          String
  description   String?
  selectionType OptionSelectionType @map("selection_type")
  isRequired    Boolean             @default(false) @map("is_required")
  minSelect     Int                 @default(0) @map("min_select")
  maxSelect     Int                 @default(1) @map("max_select")
  isActive      Boolean             @default(true) @map("is_active")
  order         Int                 @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items       OptionItem[]
  productLinks ProductOptionGroupLink[]

  @@index([tenantId])
  @@map("option_groups")
}

model OptionItem {
  id               String          @id @default(uuid())
  tenantId         String          @map("tenant_id")
  optionGroupId    String          @map("option_group_id")
  name             String
  description      String?
  sku              String?
  isActive         Boolean         @default(true) @map("is_active")
  order            Int             @default(0)

  priceImpactType  PriceImpactType @default(none) @map("price_impact_type")
  priceImpactValue Decimal         @default(0) @map("price_impact_value") @db.Decimal(10, 2)

  allowQuantity Boolean @default(false) @map("allow_quantity")
  minQty        Int?    @map("min_qty")
  maxQty        Int?    @map("max_qty")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  optionGroup OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([optionGroupId])
  @@map("option_items")
}

model ProductOptionGroupLink {
  id            String @id @default(uuid())
  tenantId      String @map("tenant_id")
  productId     String @map("product_id")
  optionGroupId String @map("option_group_id")
  order         Int    @default(0)

  // Overrides (optional)
  overrideName        String? @map("override_name")
  overrideDescription String? @map("override_description")
  overrideIsRequired  Boolean? @map("override_is_required")
  overrideMinSelect   Int?    @map("override_min_select")
  overrideMaxSelect   Int?    @map("override_max_select")

  // Pricing axis for replace conflict prevention
  pricingAxis PricingAxis @default(secondary) @map("pricing_axis")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionGroup OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@unique([productId, optionGroupId])
  @@index([tenantId])
  @@index([productId])
  @@map("product_option_group_links")
}

model CatalogPublication {
  id                String                  @id @default(uuid())
  tenantId          String                  @map("tenant_id")
  productId         String                  @unique @map("product_id")
  publicationStatus CatalogPublicationStatus @default(draft) @map("publication_status")
  operationalStatus CatalogOperationalStatus @default(active) @map("operational_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  rules   CatalogAvailabilityRule[]

  @@index([tenantId])
  @@index([tenantId, publicationStatus])
  @@index([tenantId, operationalStatus])
  @@map("catalog_publications")
}

model CatalogAvailabilityRule {
  id              String             @id @default(uuid())
  tenantId        String             @map("tenant_id")
  publicationId   String             @map("publication_id")
  channel         CatalogSalesChannel
  daysOfWeek      Int[]              @map("days_of_week")
  startTime       String             @map("start_time") @db.VarChar(5)
  endTime         String             @map("end_time") @db.VarChar(5)
  isActive        Boolean            @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  publication CatalogPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([publicationId])
  @@map("catalog_availability_rules")
}

model ComboSlot {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  comboProductId String @map("combo_product_id")
  name        String
  description String?
  isRequired  Boolean @default(true) @map("is_required")
  minSelect   Int     @default(1) @map("min_select")
  maxSelect   Int     @default(1) @map("max_select")
  order       Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  comboProduct Product @relation(fields: [comboProductId], references: [id], onDelete: Cascade)
  allowedItems ComboSlotAllowedItem[]

  @@index([tenantId])
  @@index([comboProductId])
  @@map("combo_slots")
}

model ComboSlotAllowedItem {
  id            String  @id @default(uuid())
  tenantId      String  @map("tenant_id")
  comboSlotId   String  @map("combo_slot_id")
  productId     String  @map("product_id")
  additionalPrice Decimal @default(0) @map("additional_price") @db.Decimal(10, 2)
  order         Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slot     ComboSlot @relation(fields: [comboSlotId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([comboSlotId, productId])
  @@index([tenantId])
  @@index([productId])
  @@map("combo_slot_allowed_items")
}

// ============================================================
// TENANT SETTINGS
// ============================================================

model TenantSettings {
  id            String  @id @default(uuid())
  tenantId      String  @unique @map("tenant_id")
  timezone      String  @default("America/Sao_Paulo") @db.VarChar(50)
  currency      String  @default("BRL") @db.VarChar(10)
  language      String  @default("pt-BR") @db.VarChar(10)
  businessPhone String? @map("business_phone") @db.VarChar(20)
  businessEmail String? @map("business_email") @db.VarChar(255)
  address       String? @db.Text
  logoUrl       String? @map("logo_url") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

// ============================================================
// TENANT USER — Users that belong to a tenant
// ============================================================

model TenantUser {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  email        String   @db.VarChar(255)
  name         String   @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles TenantUserRole[]
  cashSessions CashSession[]

  // Unique email per tenant
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("tenant_users")
}

// ============================================================
// TENANT RBAC — Roles, Permissions, Assignments
// ============================================================

model TenantRole {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(60)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions TenantRolePermission[]
  userRoles       TenantUserRole[]

  // Unique slug per tenant
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("tenant_roles")
}

model TenantPermission {
  id          String  @id @default(uuid())
  module      String  @db.VarChar(50)
  action      String  @db.VarChar(50)
  slug        String  @unique @db.VarChar(100) // e.g. "orders.read"
  description String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  rolePermissions TenantRolePermission[]

  @@map("tenant_permissions")
}

model TenantRolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  // Relations
  role       TenantRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission TenantPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("tenant_role_permissions")
}

model TenantUserRole {
  id     String @id @default(uuid())
  userId String @map("user_id")
  roleId String @map("role_id")

  // Relations
  user TenantUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role TenantRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("tenant_user_roles")
}

// ============================================================
// ADMIN USER — SaaS Admin internal users (NOT a tenant)
// ============================================================

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique @db.VarChar(255)
  name         String   @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  userRoles AdminUserRole[]

  @@map("admin_users")
}

// ============================================================
// ADMIN RBAC — Separate from tenant RBAC
// ============================================================

model AdminRole {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(60)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  rolePermissions AdminRolePermission[]
  userRoles       AdminUserRole[]

  @@map("admin_roles")
}

model AdminPermission {
  id          String  @id @default(uuid())
  module      String  @db.VarChar(50) // e.g. "saas.tenants"
  action      String  @db.VarChar(50) // e.g. "read"
  slug        String  @unique @db.VarChar(100) // e.g. "saas.tenants.read"
  description String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  rolePermissions AdminRolePermission[]

  @@map("admin_permissions")
}

model AdminRolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  // Relations
  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("admin_role_permissions")
}

model AdminUserRole {
  id     String @id @default(uuid())
  userId String @map("user_id")
  roleId String @map("role_id")

  // Relations
  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("admin_user_roles")
}

// ============================================================
// CATALOG (PHASE 2)
// ============================================================

model ProductCategory {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  name        String
  slug        String
  description String?
  image       String?
  isActive    Boolean @default(true) @map("is_active")
  isFeatured  Boolean @default(false) @map("is_featured")
  order       Int     @default(0)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("product_categories")
}

model Product {
  id               String  @id @default(uuid())
  tenantId         String  @map("tenant_id")
  categoryId       String? @map("category_id")
  type             CatalogProductType @default(simple) @map("type")
  name             String
  slug             String
  shortDescription String? @map("short_description")
  longDescription  String? @map("long_description")
  basePrice        Decimal @map("base_price") @db.Decimal(10, 2)
  image            String?
  isActive         Boolean @default(true) @map("is_active")
  isFeatured       Boolean @default(false) @map("is_featured")
  isAvailable      Boolean @default(true) @map("is_available")
  sellableOnline   Boolean @default(true) @map("sellable_online")
  sku              String?
  order            Int     @default(0)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  complementGroups ProductComplementGroupLink[]
  comboBlockItems  ProductComboBlockItem[]
  recipeIngredients ProductRecipeIngredient[]

  optionGroupLinks ProductOptionGroupLink[]
  publication      CatalogPublication?
  comboSlots       ComboSlot[]
  allowedInComboSlots ComboSlotAllowedItem[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([categoryId])
  @@map("products")
}

model ProductComplementGroup {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  name        String
  description String?
  minSelect   Int     @default(0) @map("min_select")
  maxSelect   Int     @default(1) @map("max_select")
  isRequired  Boolean @default(false) @map("is_required")
  isActive    Boolean @default(true) @map("is_active")
  order       Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items        ProductComplementItem[]
  productLinks ProductComplementGroupLink[]

  @@index([tenantId])
  @@map("product_complement_groups")
}

model ProductComplementItem {
  id              String  @id @default(uuid())
  tenantId        String  @map("tenant_id")
  groupId         String  @map("group_id")
  name            String
  description     String?
  additionalPrice Decimal @default(0) @map("additional_price") @db.Decimal(10, 2)
  sku             String?
  isActive        Boolean @default(true) @map("is_active")
  order           Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group  ProductComplementGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  recipeIngredients ComplementRecipeIngredient[]

  @@index([tenantId])
  @@index([groupId])
  @@map("product_complement_items")
}

model ProductComplementGroupLink {
  id                String @id @default(uuid())
  tenantId          String @map("tenant_id")
  productId         String @map("product_id")
  complementGroupId String @map("complement_group_id")
  order             Int    @default(0)

  tenant  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  group   ProductComplementGroup @relation(fields: [complementGroupId], references: [id], onDelete: Cascade)

  @@unique([productId, complementGroupId])
  @@index([tenantId])
  @@map("product_complement_group_links")
}

model ProductCombo {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  name        String
  slug        String
  description String?
  basePrice   Decimal @map("base_price") @db.Decimal(10, 2)
  image       String?
  isActive    Boolean @default(true) @map("is_active")
  isFeatured  Boolean @default(false) @map("is_featured")
  order       Int     @default(0)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  blocks ProductComboBlock[]
  recipeIngredients ComboRecipeIngredient[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("product_combos")
}

model ProductComboBlock {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  comboId     String  @map("combo_id")
  name        String
  description String?
  minSelect   Int     @default(1) @map("min_select")
  maxSelect   Int     @default(1) @map("max_select")
  order       Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  combo  ProductCombo            @relation(fields: [comboId], references: [id], onDelete: Cascade)
  items  ProductComboBlockItem[]

  @@index([tenantId])
  @@index([comboId])
  @@map("product_combo_blocks")
}

model ProductComboBlockItem {
  id              String  @id @default(uuid())
  tenantId        String  @map("tenant_id")
  blockId         String  @map("block_id")
  productId       String  @map("product_id")
  additionalPrice Decimal @default(0) @map("additional_price") @db.Decimal(10, 2)
  order           Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  block   ProductComboBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  product Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([blockId, productId])
  @@index([tenantId])
  @@index([productId])
  @@map("product_combo_block_items")
}

// ============================================================
// ORDERS (PHASE 4)
// ============================================================

enum OrderStatus {
  pending
  confirmed
  preparing
  ready_for_pickup
  ready_for_delivery
  out_for_delivery
  completed
  cancelled
}

enum FulfillmentType {
  delivery
  pickup
  dine_in
}

enum OrderLineType {
  product
  combo
}

model Order {
  id              String          @id @default(uuid())
  tenantId        String          @map("tenant_id")
  orderNumber     String          @map("order_number") @db.VarChar(20)
  status          OrderStatus     @default(pending)
  fulfillmentType FulfillmentType @map("fulfillment_type")

  // Customer data
  customerName  String  @map("customer_name") @db.VarChar(150)
  customerPhone String  @map("customer_phone") @db.VarChar(30)
  customerEmail String? @map("customer_email") @db.VarChar(255)

  // Monetary breakdown
  itemsSubtotal Decimal @map("items_subtotal") @db.Decimal(10, 2)
  discountTotal Decimal @default(0) @map("discount_total") @db.Decimal(10, 2)
  deliveryFee   Decimal @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  serviceFee    Decimal @default(0) @map("service_fee") @db.Decimal(10, 2)
  total         Decimal @db.Decimal(10, 2)

  // Operational
  sourceChannel  String  @default("storefront") @map("source_channel") @db.VarChar(30)
  idempotencyKey String  @map("idempotency_key") @db.VarChar(100)
  notes          String? @db.Text
  paymentMethod  PaymentMethod? @map("payment_method")
  cashSessionId  String?        @map("cash_session_id")

  // Delivery snapshot (optional)
  deliveryLat Float? @map("delivery_lat")
  deliveryLng Float? @map("delivery_lng")

  // Public tracking token (non-enumerable, shareable)
  publicTrackingToken String @unique @map("public_tracking_token")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  deliveryAddress OrderDeliveryAddress?
  timeline        OrderTimeline[]
  deliveryDriverId String?              @map("delivery_driver_id")
  deliveryDriver   DeliveryDriver?      @relation(fields: [deliveryDriverId], references: [id])
  cashSession      CashSession?         @relation(fields: [cashSessionId], references: [id])
  cashMovements    CashMovement[]
  customerId       String?              @map("customer_id")
  customer         Customer?            @relation(fields: [customerId], references: [id])
  couponId         String?              @map("coupon_id")
  coupon           Coupon?              @relation(fields: [couponId], references: [id])
  cashbackUsed     Decimal?             @map("cashback_used") @db.Decimal(10,2)
  cashbackHistory  CashbackTransaction[]
  stockMovements   StockMovement[]

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("orders")
}

model OrderItem {
  id        String        @id @default(uuid())
  orderId   String        @map("order_id")
  tenantId  String        @map("tenant_id")
  lineType  OrderLineType @map("line_type")
  productId String?       @map("product_id")
  comboId   String?       @map("combo_id")
  quantity  Int
  unitPrice Decimal       @map("unit_price") @db.Decimal(10, 2)
  lineTotal Decimal       @map("line_total") @db.Decimal(10, 2)
  notes     String?       @db.Text

  // Commercial snapshot for audit
  snapshotName       String  @map("snapshot_name") @db.VarChar(200)
  snapshotImage      String? @map("snapshot_image") @db.VarChar(500)
  snapshotBasePrice  Decimal @map("snapshot_base_price") @db.Decimal(10, 2)
  snapshotExtrasTotal Decimal @map("snapshot_extras_total") @db.Decimal(10, 2)
  snapshotComposition String? @map("snapshot_composition") @db.Text

  snapshotCatalogV2Json Json? @map("snapshot_catalog_v2_json")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order           Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  complements     OrderItemComplement[]
  comboSelections OrderItemComboSelection[]

  @@index([orderId])
  @@index([tenantId])
  @@map("order_items")
}

model OrderItemComplement {
  id               String  @id @default(uuid())
  orderItemId      String  @map("order_item_id")
  tenantId         String  @map("tenant_id")
  complementItemId String  @map("complement_item_id")
  snapshotName     String  @map("snapshot_name") @db.VarChar(200)
  snapshotPrice    Decimal @map("snapshot_price") @db.Decimal(10, 2)

  // Relations
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_complements")
}

model OrderItemComboSelection {
  id                      String  @id @default(uuid())
  orderItemId             String  @map("order_item_id")
  tenantId                String  @map("tenant_id")
  comboBlockItemId        String  @map("combo_block_item_id")
  snapshotBlockName       String  @map("snapshot_block_name") @db.VarChar(200)
  snapshotProductName     String  @map("snapshot_product_name") @db.VarChar(200)
  snapshotAdditionalPrice Decimal @map("snapshot_additional_price") @db.Decimal(10, 2)

  // Relations
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_combo_selections")
}

model OrderDeliveryAddress {
  id           String  @id @default(uuid())
  orderId      String  @unique @map("order_id")
  tenantId     String  @map("tenant_id")
  street       String  @db.VarChar(255)
  number       String  @db.VarChar(20)
  complement   String? @db.VarChar(100)
  neighborhood String  @db.VarChar(100)
  city         String  @db.VarChar(100)
  state        String  @db.VarChar(2)
  zipCode      String  @map("zip_code") @db.VarChar(10)
  reference    String? @db.VarChar(255)
  lat          Float?
  lng          Float?

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("order_delivery_addresses")
}

model OrderTimeline {
  id        String      @id @default(uuid())
  orderId   String      @map("order_id")
  tenantId  String      @map("tenant_id")
  status    OrderStatus
  note      String?     @db.Text
  actorId   String?     @map("actor_id")
  actorType String?     @default("tenant_user") @map("actor_type")
  createdAt DateTime    @default(now()) @map("created_at")

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([tenantId])
  @@map("order_timelines")
}

// ============================================================
// LOGISTICS / DELIVERY — Phase 6
// ============================================================

model DeliveryDriver {
  id           String             @id @default(uuid())
  tenantId     String             @map("tenant_id")
  name         String             @db.VarChar(150)
  phone        String             @db.VarChar(30)
  isActive     Boolean            @default(true) @map("is_active")
  status       DriverStatus       @default(offline)
  vehicleType  DriverVehicleType  @default(motorcycle) @map("vehicle_type")
  notes        String?            @db.Text
  currentLat   Float?             @map("current_lat")
  currentLng   Float?             @map("current_lng")
  lastLocationAt DateTime?        @map("last_location_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  // Relations
  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]
  locations DeliveryDriverLocation[]

  @@index([tenantId])
  @@map("delivery_drivers")
}

model DeliveryDriverLocation {
  id        String   @id @default(uuid())
  driverId  String   @map("driver_id")
  tenantId  String   @map("tenant_id")
  lat       Float
  lng       Float
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driver DeliveryDriver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, driverId, createdAt])
  @@map("delivery_driver_locations")
}

enum DriverStatus {
  available
  busy
  offline
}

enum DriverVehicleType {
  motorcycle
  bicycle
  car
}

// ============================================================
// PDV + CASH REGISTER — Phase 7
// ============================================================

enum PaymentMethod {
  cash
  pix
  credit_card
  debit_card
  other
}

enum CashSessionStatus {
  open
  closed
}

enum CashMovementType {
  opening
  sale
  withdrawal
  supply
  refund
  adjustment
  closing
}

model CashSession {
  id                      String            @id @default(uuid())
  tenantId                String            @map("tenant_id")
  operatorId              String            @map("operator_id")
  status                  CashSessionStatus @default(open)
  openingAmount           Decimal           @map("opening_amount") @db.Decimal(10, 2)
  closingAmountDeclared   Decimal?          @map("closing_amount_declared") @db.Decimal(10, 2)
  closingAmountCalculated Decimal?          @map("closing_amount_calculated") @db.Decimal(10, 2)
  closingDifference       Decimal?          @map("closing_difference") @db.Decimal(10, 2)
  notes                   String?           @db.Text
  openedAt                DateTime          @default(now()) @map("opened_at")
  closedAt                DateTime?         @map("closed_at")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  // Relations
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operator  TenantUser     @relation(fields: [operatorId], references: [id])
  movements CashMovement[]
  orders    Order[]

  @@index([tenantId])
  @@index([operatorId])
  @@map("cash_sessions")
}

model CashMovement {
  id            String           @id @default(uuid())
  tenantId      String           @map("tenant_id")
  cashSessionId String           @map("cash_session_id")
  type          CashMovementType
  amount        Decimal          @db.Decimal(10, 2)
  paymentMethod PaymentMethod?   @map("payment_method")
  orderId       String?          @map("order_id")
  description   String?          @db.Text
  createdAt     DateTime         @default(now()) @map("created_at")

  // Relations
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  order       Order?      @relation(fields: [orderId], references: [id])

  @@index([cashSessionId])
  @@index([tenantId])
  @@map("cash_movements")
}

// ============================================================
// CRM & COMMERCIAL — Phase 8
// ============================================================

model Customer {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  name             String   @db.VarChar(150)
  phone            String   @db.VarChar(30)
  email            String?  @db.VarChar(255)
  notes            String?  @db.Text
  
  // Agregados
  totalOrders      Int      @default(0) @map("total_orders")
  totalSpent       Decimal  @default(0) @map("total_spent") @db.Decimal(10, 2)
  lastOrderDate    DateTime? @map("last_order_date")
  
  // Saldos
  loyaltyPoints    Int      @default(0) @map("loyalty_points")
  cashbackBalance  Decimal  @default(0) @map("cashback_balance") @db.Decimal(10, 2)

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders           Order[]
  cashbackHistory  CashbackTransaction[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("customers")
}

enum CouponType {
  percentage
  fixed_amount
  free_shipping
}

model Coupon {
  id               String     @id @default(uuid())
  tenantId         String     @map("tenant_id")
  code             String     @db.VarChar(50)
  name             String     @db.VarChar(100)
  description      String?    @db.Text
  type             CouponType
  value            Decimal    @db.Decimal(10, 2)
  minOrderValue    Decimal?   @map("min_order_value") @db.Decimal(10, 2)
  maxDiscountValue Decimal?   @map("max_discount_value") @db.Decimal(10, 2)
  usageLimit       Int?       @map("usage_limit")
  usedCount        Int        @default(0) @map("used_count")
  startsAt         DateTime?  @map("starts_at")
  expiresAt        DateTime?  @map("expires_at")
  isActive         Boolean    @default(true) @map("is_active")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders           Order[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("coupons")
}

enum CashbackTransactionType {
  earned
  redeemed
  adjustment
  expired
}

model CashbackTransaction {
  id          String                  @id @default(uuid())
  tenantId    String                  @map("tenant_id")
  customerId  String                  @map("customer_id")
  orderId     String?                 @map("order_id")
  type        CashbackTransactionType
  amount      Decimal                 @db.Decimal(10, 2)
  description String?                 @db.VarChar(255)
  createdAt   DateTime                @default(now()) @map("created_at")

  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order       Order?                  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([customerId])
  @@map("cashback_transactions")
}

// ============================================================
// INVENTORY & COSTS — Phase 9
// ============================================================

enum UnitType {
  un
  g
  kg
  ml
  l
}

model Ingredient {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  name             String   @db.VarChar(150)
  sku              String?  @db.VarChar(50)
  description      String?  @db.Text
  unit             UnitType
  currentCost      Decimal  @default(0) @map("current_cost") @db.Decimal(10, 4)
  currentStock     Decimal  @default(0) @map("current_stock") @db.Decimal(10, 4)
  minStock         Decimal? @map("min_stock") @db.Decimal(10, 4)
  isActive         Boolean  @default(true) @map("is_active")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements        StockMovement[]
  productRecipes   ProductRecipeIngredient[]
  complementRecipes ComplementRecipeIngredient[]
  comboRecipes     ComboRecipeIngredient[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@map("ingredients")
}

enum StockMovementType {
  in
  out
  adjust
  waste
  theoretical_depletion
}

model StockMovement {
  id            String            @id @default(uuid())
  tenantId      String            @map("tenant_id")
  ingredientId  String            @map("ingredient_id")
  type          StockMovementType
  quantity      Decimal           @db.Decimal(10, 4)
  unitCost      Decimal?          @map("unit_cost") @db.Decimal(10, 4)
  orderId       String?           @map("order_id")
  userId        String?           @map("user_id")
  notes         String?           @db.VarChar(255)
  createdAt     DateTime          @default(now()) @map("created_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  order      Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([ingredientId])
  @@map("stock_movements")
}

model ProductRecipeIngredient {
  id           String  @id @default(uuid())
  tenantId     String  @map("tenant_id")
  productId    String  @map("product_id")
  ingredientId String  @map("ingredient_id")
  quantity     Decimal @db.Decimal(10, 4)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
  @@index([tenantId])
  @@map("product_recipe_ingredients")
}

model ComplementRecipeIngredient {
  id               String  @id @default(uuid())
  tenantId         String  @map("tenant_id")
  complementItemId String  @map("complement_item_id")
  ingredientId     String  @map("ingredient_id")
  quantity         Decimal @db.Decimal(10, 4)

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  complement ProductComplementItem @relation(fields: [complementItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient            @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([complementItemId, ingredientId])
  @@index([tenantId])
  @@map("complement_recipe_ingredients")
}

model ComboRecipeIngredient {
  id           String  @id @default(uuid())
  tenantId     String  @map("tenant_id")
  comboId      String  @map("combo_id")
  ingredientId String  @map("ingredient_id")
  quantity     Decimal @db.Decimal(10, 4)

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  combo      ProductCombo @relation(fields: [comboId], references: [id], onDelete: Cascade)
  ingredient Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([comboId, ingredientId])
  @@index([tenantId])
  @@map("combo_recipe_ingredients")
}

// ============================================================
// DELIVERY RATES - Phase 4 (hardening)
// ============================================================

enum RateType {
  neighborhood
  distance
  fixed
  polygon
}

 enum DeliveryZoneKind {
   blocked_zone
   custom_zone
 }

 enum DeliveryPricingMode {
   fixed
   distance
   free
 }

 model DeliveryCoverageConfig {
   id                String   @id @default(uuid())
   tenantId           String   @unique @map("tenant_id")
   storeLat           Float    @map("store_lat")
   storeLng           Float    @map("store_lng")
   maxRadiusKm        Decimal  @map("max_radius_km") @db.Decimal(6, 2)
   defaultPricePerKm  Decimal  @map("default_price_per_km") @db.Decimal(10, 2)
   minimumFee         Decimal? @map("minimum_fee") @db.Decimal(10, 2)
   maximumFee         Decimal? @map("maximum_fee") @db.Decimal(10, 2)
   isDeliveryEnabled  Boolean  @default(true) @map("is_delivery_enabled")

   createdAt DateTime @default(now()) @map("created_at")
   updatedAt DateTime @updatedAt @map("updated_at")

   tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

   @@index([tenantId])
   @@map("delivery_coverage_configs")
 }

model DeliveryRateRule {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  type        RateType
  isActive    Boolean   @default(true) @map("is_active")

  priority    Int       @default(1000) @map("priority")
  isFallback  Boolean   @default(false) @map("is_fallback")

  // Para bairro
  neighborhood String?   @db.VarChar(100)
  rate         Decimal?  @map("rate") @db.Decimal(10, 2)

  // Para distância
  minKm        Decimal?  @map("min_km") @db.Decimal(5, 2)
  maxKm        Decimal?  @map("max_km") @db.Decimal(5, 2)
  ratePerKm    Decimal?  @map("rate_per_km") @db.Decimal(10, 2)

  minDistanceKm Decimal? @map("min_distance_km") @db.Decimal(5, 2)
  maxDistanceKm Decimal? @map("max_distance_km") @db.Decimal(5, 2)

  // Para taxa fixa (fallback)
  fixedRate    Decimal?  @map("fixed_rate") @db.Decimal(10, 2)

  // Preparação para área/polígono (não implementado ainda)
  geoJson             Json? @map("geo_json")
  polygonCoordinates  Json? @map("polygon_coordinates")

   // Zonas desenhadas (uso principal quando type=polygon)
   name          String?           @db.VarChar(120)
   color         String?           @db.VarChar(16)
   zoneKind      DeliveryZoneKind? @map("zone_kind")
   pricingMode   DeliveryPricingMode? @map("pricing_mode")
   fixedFee      Decimal?          @map("fixed_fee") @db.Decimal(10, 2)
   pricePerKm    Decimal?          @map("price_per_km") @db.Decimal(10, 2)
   blocksDelivery Boolean          @default(false) @map("blocks_delivery")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, priority])
  @@index([tenantId, type, neighborhood])
  @@map("delivery_rate_rules")
}

// ============================================================
// TENANT MODULE ACCESS - Phase 4 (hardening)
// ============================================================

model TenantModuleAccess {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  module    String   @db.VarChar(50)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module])
  @@index([tenantId])
  @@map("tenant_module_access")
}

// ============================================================
// ANALYTICS & GOALS — Phase 10
// ============================================================

enum GoalType {
  revenue
  orders
  avg_ticket
  preparation_time
  delivery_time
  orders_by_channel
  orders_by_category
  gross_margin
}

enum GoalStatus {
  draft
  active
  paused
  achieved
  missed
}

model Goal {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String   @db.VarChar(100)
  description String?  @db.Text
  type        GoalType
  targetValue Decimal  @map("target_value") @db.Decimal(10, 2)
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  status      GoalStatus @default(active)
  
  // Desdobramentos (Subgoals)
  parentId    String?  @map("parent_id")
  parent      Goal?    @relation("SubGoals", fields: [parentId], references: [id])
  subGoals    Goal[]   @relation("SubGoals")

  // For specific targets (channel, category, product)
  targetId    String?  @map("target_id") @db.VarChar(100)
  
  responsibleId String? @map("responsible_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("goals")
}
