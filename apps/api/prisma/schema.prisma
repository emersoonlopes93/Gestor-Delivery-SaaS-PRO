generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model BusinessGroup {
  id                   String   @id @default(uuid())
  name                 String   @db.VarChar(100)
  ownerId              String?  @map("owner_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  headquartersTenantId String?  @unique @map("headquarters_tenant_id")
  headquartersTenant   Tenant?  @relation("BusinessGroupHeadquarters", fields: [headquartersTenantId], references: [id])
  tenants              Tenant[] @relation("TenantBusinessGroupMembers")

  @@map("business_groups")
}

model Tenant {
  id                             String                             @id @default(uuid())
  businessGroupId                String?                            @map("business_group_id")
  name                           String                             @db.VarChar(100)
  slug                           String                             @unique @db.VarChar(60)
  status                         TenantStatus                       @default(active)
  createdAt                      DateTime                           @default(now()) @map("created_at")
  updatedAt                      DateTime                           @updatedAt @map("updated_at")
  orderSequence                  Int                                @default(0) @map("order_sequence")
  businessGroupRole              BusinessGroupTenantRole?           @map("business_group_role")
  paymentTransactions            PaymentTransaction[]
  TenantSubscription             TenantSubscription?
  aiAgentConfig                  AiAgentConfig?
  auditLogs                      AuditLog[]
  baseMenuImportLogs             BaseMenuImportLog[]
  billingCycles                  BillingCycleRecord[]
  paymentMethods                 BillingPaymentMethod[]
  billingUsageSnapshots          BillingUsageSnapshot[]
  headquartersForGroup           BusinessGroup?                     @relation("BusinessGroupHeadquarters")
  campaigns                      Campaign[]
  cashMovements                  CashMovement[]
  cashSessions                   CashSession[]
  cashbackTransactions           CashbackTransaction[]
  catalogAvailabilityRules       CatalogAvailabilityRule[]
  catalogPublications            CatalogPublication[]
  chatSessions                   ChatSession[]
  comboBundleItems               ComboBundleItem[]
  comboRecipeIngredients         ComboRecipeIngredient[]
  comboSlotAllowedItems          ComboSlotAllowedItem[]
  comboSlots                     ComboSlot[]
  complementRecipeIngredients    ComplementRecipeIngredient[]
  coupons                        Coupon[]
  crmNotes                       CrmNote[]
  crmPipelineEntries             CrmPipelineEntry[]
  crmTasks                       CrmTask[]
  customerAddresses              CustomerAddress[]
  customerLoyaltyTransactions    CustomerLoyaltyTransaction[]
  customerOptOuts                CustomerOptOut[]
  customerOtps                   CustomerOTP[]
  customerWalletTransactions     CustomerWalletTransaction[]
  customers                      Customer[]
  deliveryCoverageConfig         DeliveryCoverageConfig?
  deliveryDriverLocations        DeliveryDriverLocation[]
  deliveryDrivers                DeliveryDriver[]
  DeliveryRateDistanceTier       DeliveryRateDistanceTier[]
  deliveryRateRules              DeliveryRateRule[]
  dineInTables                   DineInTable[]
  financialAccounts              FinancialAccount[]
  financialTransactions          FinancialTransaction[]
  goals                          Goal[]
  ingredients                    Ingredient[]
  inventoryCountItems            InventoryCountItem[]
  inventoryCounts                InventoryCount[]
  invoices                       Invoice[]
  marketingAutomations           MarketingAutomation[]
  marketplaceConnections         MarketplaceConnection[]
  marketplaceEventInboxes        MarketplaceEventInbox[]
  marketplaceOrders              MarketplaceOrder[]
  mediaAssets                    MediaAsset[]
  mediaCategories                MediaCategory[]
  optionGroups                   OptionGroup[]
  optionItems                    OptionItem[]
  orderDeliveryAddresses         OrderDeliveryAddress[]
  OrderFeedback                  OrderFeedback[]
  order_item_combo_selections    order_item_combo_selections[]
  order_item_complements         order_item_complements[]
  orderItems                     OrderItem[]
  orderSplits                    OrderSplit[]
  orderTimelines                 OrderTimeline[]
  orders                         Order[]
  paymentAttempts                PaymentAttempt[]
  printJobs                      PrintJob[]
  printStations                  PrintStation[]
  printerDevices                 PrinterDevice[]
  categories                     ProductCategory[]
  product_combo_block_items      product_combo_block_items[]
  product_combo_blocks           product_combo_blocks[]
  product_combos                 product_combos[]
  product_complement_group_links product_complement_group_links[]
  product_complement_groups      product_complement_groups[]
  product_complement_items       product_complement_items[]
  productOptionGroupLinks        ProductOptionGroupLink[]
  productOptionItemPrices        ProductOptionItemPrice[]
  productRecipeIngredients       ProductRecipeIngredient[]
  productUpsells                 ProductUpsell[]
  products                       Product[]
  purchaseItems                  PurchaseItem[]
  purchases                      Purchase[]
  quickReplies                   QuickReply[]
  revenueEvents                  RevenueEvent[]
  scheduledOrders                ScheduledOrder[]
  schedulingSettings             SchedulingSettings?
  schedulingWindows              SchedulingWindow[]
  splitPayments                  SplitPayment[]
  stockMovements                 StockMovement[]
  subscriptionStatusHistory      SubscriptionStatusHistory[]
  suppliers                      Supplier[]
  tenantAddons                   TenantAddon[]
  billingSubscriptions           TenantBillingSubscription[]
  featureEntitlementOverrides    TenantFeatureEntitlementOverride[]
  featureTenantOverrides         FeatureTenantOverride[]
  moduleAccess                   TenantModuleAccess[]
  onboarding                     TenantOnboarding?
  operatingHours                 TenantOperatingHours[]
  roles                          TenantRole[]
  settings                       TenantSettings?
  users                          TenantUser[]
  businessGroup                  BusinessGroup?                     @relation("TenantBusinessGroupMembers", fields: [businessGroupId], references: [id])
  timeSlots                      TimeSlot[]
  upsellItems                    UpsellItem[]
  upsells                        Upsell[]
  whatsappInstance               WhatsAppInstance?
  pushSubscriptions              PushSubscription[]

  @@map("tenants")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String?  @map("user_id")
  userType  String   @map("user_type")
  action    String   @db.VarChar(100)
  resource  String?  @db.VarChar(100)
  details   Json?
  ip        String?  @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

model AuthSession {
  id                   String            @id @default(uuid())
  subjectType          AuthSubjectType   @map("subject_type")
  subjectId            String            @map("subject_id")
  tenantId             String?           @map("tenant_id")
  adminUserId          String?           @map("admin_user_id")
  userId               String?           @map("user_id")
  role                 String?           @db.VarChar(80)
  refreshTokenHash     String            @map("refresh_token_hash") @db.VarChar(128)
  refreshTokenFamilyId String            @map("refresh_token_family_id") @db.VarChar(64)
  previousSessionId    String?           @map("previous_session_id")
  userAgent            String?           @map("user_agent") @db.VarChar(500)
  ipAddress            String?           @map("ip_address") @db.VarChar(45)
  deviceLabel          String?           @map("device_label") @db.VarChar(120)
  status               AuthSessionStatus @default(active)
  createdAt            DateTime          @default(now()) @map("created_at")
  lastUsedAt           DateTime          @default(now()) @map("last_used_at")
  expiresAt            DateTime          @map("expires_at")
  revokedAt            DateTime?         @map("revoked_at")
  revokedReason        String?           @map("revoked_reason") @db.VarChar(120)
  replacedBySessionId  String?           @map("replaced_by_session_id")
  metadata             Json?

  @@index([subjectType, subjectId])
  @@index([tenantId])
  @@index([adminUserId])
  @@index([userId])
  @@index([refreshTokenFamilyId])
  @@index([status])
  @@map("auth_sessions")
}

model ExternalWebhookEvent {
  id                String             @id @default(uuid())
  provider          String             @db.VarChar(60)
  eventId           String             @map("event_id") @db.VarChar(180)
  signatureHash     String?            @map("signature_hash") @db.VarChar(128)
  receivedAt        DateTime           @default(now()) @map("received_at")
  processedAt       DateTime?          @map("processed_at")
  status            WebhookEventStatus @default(received)
  attempts          Int                @default(0)
  lastError         String?            @map("last_error")
  payloadHash       String             @map("payload_hash") @db.VarChar(128)
  tenantId          String?            @map("tenant_id")
  relatedEntityType String?            @map("related_entity_type") @db.VarChar(80)
  relatedEntityId   String?            @map("related_entity_id") @db.VarChar(120)
  metadata          Json?

  @@unique([provider, eventId])
  @@index([provider, status])
  @@index([tenantId])
  @@index([payloadHash])
  @@map("external_webhook_events")
}

model TenantOnboarding {
  id                 String    @id @default(uuid())
  tenantId           String    @unique @map("tenant_id")
  stepBasicInfo      Boolean   @default(false) @map("step_basic_info")
  stepOperatingHours Boolean   @default(false) @map("step_operating_hours")
  stepLogo           Boolean   @default(false) @map("step_logo")
  stepAddress        Boolean   @default(false) @map("step_address")
  stepDelivery       Boolean   @default(false) @map("step_delivery")
  stepPayments       Boolean   @default(false) @map("step_payments")
  stepWhatsapp       Boolean   @default(false) @map("step_whatsapp")
  stepMenu           Boolean   @default(false) @map("step_menu")
  stepCatalog        Boolean   @default(false) @map("step_catalog")
  stepFirstOrder     Boolean   @default(false) @map("step_first_order")
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_onboardings")
}

model OptionGroup {
  id                    String                   @id @default(uuid())
  tenantId              String                   @map("tenant_id")
  name                  String
  description           String?
  selectionType         OptionSelectionType      @map("selection_type")
  isRequired            Boolean                  @default(false) @map("is_required")
  minSelect             Int                      @default(0) @map("min_select")
  maxSelect             Int                      @default(1) @map("max_select")
  isActive              Boolean                  @default(true) @map("is_active")
  order                 Int                      @default(0)
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  fractionalPricingRule FractionalPricingRule?   @map("fractional_pricing_rule")
  tenant                Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items                 OptionItem[]
  productLinks          ProductOptionGroupLink[]

  @@index([tenantId])
  @@map("option_groups")
}

model OptionItem {
  id               String                   @id @default(uuid())
  tenantId         String                   @map("tenant_id")
  optionGroupId    String                   @map("option_group_id")
  name             String
  description      String?
  sku              String?
  isActive         Boolean                  @default(true) @map("is_active")
  order            Int                      @default(0)
  priceImpactType  PriceImpactType          @default(none) @map("price_impact_type")
  priceImpactValue Decimal                  @default(0) @map("price_impact_value") @db.Decimal(10, 2)
  allowQuantity    Boolean                  @default(false) @map("allow_quantity")
  minQty           Int?                     @map("min_qty")
  maxQty           Int?                     @map("max_qty")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  optionGroup      OptionGroup              @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productPrices    ProductOptionItemPrice[]

  @@index([tenantId])
  @@index([optionGroupId])
  @@map("option_items")
}

model ProductOptionItemPrice {
  id           String     @id @default(uuid())
  tenantId     String     @map("tenant_id")
  productId    String     @map("product_id")
  optionItemId String     @map("option_item_id")
  price        Decimal    @db.Decimal(10, 2)
  costPrice    Decimal?   @map("cost_price") @db.Decimal(10, 2)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  optionItem   OptionItem @relation(fields: [optionItemId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([productId, optionItemId])
  @@index([tenantId])
  @@map("product_option_item_prices")
}

model ProductOptionGroupLink {
  id                  String      @id @default(uuid())
  tenantId            String      @map("tenant_id")
  productId           String      @map("product_id")
  optionGroupId       String      @map("option_group_id")
  order               Int         @default(0)
  overrideName        String?     @map("override_name")
  overrideDescription String?     @map("override_description")
  overrideIsRequired  Boolean?    @map("override_is_required")
  overrideMinSelect   Int?        @map("override_min_select")
  overrideMaxSelect   Int?        @map("override_max_select")
  pricingAxis         PricingAxis @default(secondary) @map("pricing_axis")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  optionGroup         OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  product             Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant              Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([productId, optionGroupId])
  @@index([tenantId])
  @@index([productId])
  @@map("product_option_group_links")
}

model CatalogPublication {
  id                String                    @id @default(uuid())
  tenantId          String                    @map("tenant_id")
  productId         String                    @unique @map("product_id")
  publicationStatus CatalogPublicationStatus  @default(draft) @map("publication_status")
  operationalStatus CatalogOperationalStatus  @default(active) @map("operational_status")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  rules             CatalogAvailabilityRule[]
  product           Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, publicationStatus])
  @@index([tenantId, operationalStatus])
  @@map("catalog_publications")
}

model CatalogAvailabilityRule {
  id            String              @id @default(uuid())
  tenantId      String              @map("tenant_id")
  publicationId String              @map("publication_id")
  channel       CatalogSalesChannel
  daysOfWeek    Int[]               @map("days_of_week")
  startTime     String              @map("start_time") @db.VarChar(5)
  endTime       String              @map("end_time") @db.VarChar(5)
  isActive      Boolean             @default(true) @map("is_active")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  publication   CatalogPublication  @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([publicationId])
  @@map("catalog_availability_rules")
}

model ComboSlot {
  id             String                 @id @default(uuid())
  tenantId       String                 @map("tenant_id")
  comboProductId String                 @map("combo_product_id")
  name           String
  description    String?
  isRequired     Boolean                @default(true) @map("is_required")
  minSelect      Int                    @default(1) @map("min_select")
  maxSelect      Int                    @default(1) @map("max_select")
  order          Int                    @default(0)
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  allowedItems   ComboSlotAllowedItem[]
  comboProduct   Product                @relation(fields: [comboProductId], references: [id], onDelete: Cascade)
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([comboProductId])
  @@map("combo_slots")
}

model ComboSlotAllowedItem {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  comboSlotId     String    @map("combo_slot_id")
  productId       String    @map("product_id")
  additionalPrice Decimal   @default(0) @map("additional_price") @db.Decimal(10, 2)
  order           Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  slot            ComboSlot @relation(fields: [comboSlotId], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([comboSlotId, productId])
  @@index([tenantId])
  @@index([productId])
  @@map("combo_slot_allowed_items")
}

model TenantSettings {
  id                           String                 @id @default(uuid())
  tenantId                     String                 @unique @map("tenant_id")
  timezone                     String                 @default("America/Sao_Paulo") @db.VarChar(50)
  currency                     String                 @default("BRL") @db.VarChar(10)
  language                     String                 @default("pt-BR") @db.VarChar(10)
  businessPhone                String?                @map("business_phone") @db.VarChar(20)
  businessEmail                String?                @map("business_email") @db.VarChar(255)
  address                      String?
  logoUrl                      String?                @map("logo_url") @db.VarChar(500)
  createdAt                    DateTime               @default(now()) @map("created_at")
  updatedAt                    DateTime               @updatedAt @map("updated_at")
  isStorePaused                Boolean                @default(false) @map("is_store_paused")
  storePauseReason             String?                @map("store_pause_reason")
  bankAccount                  String?                @map("bank_account") @db.VarChar(50)
  bankAgency                   String?                @map("bank_agency") @db.VarChar(20)
  bankName                     String?                @map("bank_name") @db.VarChar(100)
  city                         String?                @db.VarChar(100)
  cnpj                         String?                @db.VarChar(18)
  complement                   String?                @db.VarChar(255)
  inscricaoEstadual            String?                @map("inscricao_estadual") @db.VarChar(20)
  lat                          Float?
  lng                          Float?
  neighborhood                 String?                @db.VarChar(100)
  number                       String?                @db.VarChar(20)
  paymentMethods               Json?                  @map("payment_methods")
  pixKey                       String?                @map("pix_key") @db.VarChar(255)
  razaoSocial                  String?                @map("razao_social") @db.VarChar(255)
  state                        String?                @db.VarChar(2)
  street                       String?                @db.VarChar(255)
  zipCode                      String?                @map("zip_code") @db.VarChar(10)
  taxRegime                    String?                @map("tax_regime") @db.VarChar(20)
  mercadoPagoAccessToken       String?                @map("mercado_pago_access_token") @db.VarChar(500)
  mercadoPagoPublicKey         String?                @map("mercado_pago_public_key") @db.VarChar(255)
  mercadoPagoWebhookSecret     String?                @map("mercado_pago_webhook_secret") @db.VarChar(255)
  standardCfop                 String?                @map("standard_cfop") @db.VarChar(10)
  standardNcm                  String?                @map("standard_ncm") @db.VarChar(10)
  whatsappNotificationsEnabled Boolean                @default(false) @map("whatsapp_notifications_enabled")
  notificationTemplates        Json?                  @map("notification_templates")
  audioNotificationEnabled     Boolean                @default(true) @map("audio_notification_enabled")
  newOrderSound                String                 @default("notification.mp3") @map("new_order_sound")
  cancellationSound            String                 @default("notification.mp3") @map("cancellation_sound")
  notificationVolume           Float                  @default(1.0) @map("notification_volume")
  storefrontLayoutJson         Json?                  @map("storefront_layout_json")
  storefrontThemeJson          Json?                  @map("storefront_theme_json")
  handoffSound                 String                 @default("notification.mp3") @map("handoff_sound") @db.VarChar(255)
  readySound                   String                 @default("notification.mp3") @map("ready_sound") @db.VarChar(255)
  browserNotificationsEnabled  Boolean                @default(true) @map("browser_notifications_enabled")
  autoAcceptOrdersEnabled     Boolean                @default(false) @map("auto_accept_orders_enabled")
  autoAcceptDelaySeconds      Int                    @default(0) @map("auto_accept_delay_seconds")
  autoAcceptDeliveryOrders    Boolean                @default(true) @map("auto_accept_delivery_orders")
  autoAcceptPickupOrders      Boolean                @default(true) @map("auto_accept_pickup_orders")
  fractionalPricingRule        FractionalPricingRule? @map("fractional_pricing_rule")
  automationCooldownHours      Int                    @default(24) @map("automation_cooldown_hours")
  automationMaxMessagesPerDay  Int                    @default(1) @map("automation_max_messages_per_day")
  loyaltyEnabled               Boolean                @default(false) @map("loyalty_enabled")
  loyaltyPointsPerReal         Float                  @default(1.0) @map("loyalty_points_per_real")
  cashbackEnabled              Boolean                @default(false) @map("cashback_enabled")
  cashbackPercent              Float                  @default(0) @map("cashback_percent")
  cashbackValidityDays         Int                    @default(90) @map("cashback_validity_days")
  gamificationEnabled          Boolean                @default(true) @map("gamification_enabled")
  minimumOrderValue            Decimal?               @map("minimum_order_value") @db.Decimal(10, 2)
  pickupEnabled                Boolean                @default(false) @map("pickup_enabled")
  pickupMinMinutes             Int                    @default(20) @map("pickup_min_minutes")
  pickupMaxMinutes             Int                    @default(30) @map("pickup_max_minutes")
  orderWhatsappNumber          String?                @map("order_whatsapp_number") @db.VarChar(20)
  tenant                       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model MediaAsset {
  id                String         @id @default(cuid())
  tenantId          String?        @map("tenant_id")
  scope             String         @db.VarChar(50)
  source            String         @db.VarChar(20)
  title             String?        @db.VarChar(150)
  description       String?
  category          String?        @db.VarChar(50)
  categoryId        String?        @map("category_id")
  filename          String         @db.VarChar(255)
  originalName      String?        @map("original_name") @db.VarChar(255)
  mimeType          String         @map("mime_type") @db.VarChar(100)
  sizeBytes         Int            @map("size_bytes")
  width             Int?
  height            Int?
  path              String
  storageProvider   String         @default("local") @map("storage_provider") @db.VarChar(30)
  storageKey        String?        @map("storage_key")
  publicUrl         String         @map("public_url")
  checksum          String?        @db.VarChar(128)
  altText           String?        @map("alt_text") @db.VarChar(255)
  metadataJson      Json?          @map("metadata_json")
  tagsJson          Json?          @map("tags_json")
  status            String         @default("active") @db.VarChar(30)
  publicationStatus String         @default("published") @map("publication_status") @db.VarChar(30)
  isSystem          Boolean        @default(false) @map("is_system")
  isActive          Boolean        @default(true) @map("is_active")
  createdByUserId   String?        @map("created_by_user_id")
  deletedAt         DateTime?      @map("deleted_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  categoryRel       MediaCategory? @relation(fields: [categoryId], references: [id])
  tenant            Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products          Product[]

  @@index([tenantId])
  @@index([scope])
  @@index([isSystem])
  @@index([category])
  @@index([categoryId])
  @@index([status])
  @@index([publicationStatus])
  @@index([deletedAt])
  @@map("media_assets")
}

model MediaCategory {
  id          String       @id @default(cuid())
  tenantId    String?      @map("tenant_id")
  scope       String       @db.VarChar(50)
  name        String       @db.VarChar(100)
  slug        String       @db.VarChar(100)
  description String?
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")
  assets      MediaAsset[]
  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scope, slug])
  @@index([tenantId])
  @@index([scope])
  @@index([isActive])
  @@map("media_categories")
}

model TenantOperatingHours {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  dayOfWeek Int      @map("day_of_week")
  isOpen    Boolean  @default(true) @map("is_open")
  openTime  String?  @map("open_time") @db.VarChar(5)
