{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "outDir": "./dist",
    "rootDir": "../../",
    "ignoreDeprecations": "5.0",
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@gestor/types": ["../../packages/types/src/index.ts"],
      "@gestor/core": ["../../packages/core/src/index.ts"],
      "@gestor/pricing": ["../../packages/pricing/src/index.ts"],
      "@gestor/utils": ["../../packages/utils/src/index.ts"],
      "@gestor/auth": ["../../packages/auth/src/index.ts"],
      "@gestor/config": ["../../packages/config/src/index.ts"],
      "@gestor/theme": ["../../packages/theme/src/index.ts"],
      "@gestor/storefront-preview": ["../../packages/storefront-preview/src/index.ts"],
      "@gestor/ui": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": [
    "src",
    "../../packages/types/src",
    "../../packages/core/src",
    "../../packages/pricing/src",
    "../../packages/utils/src",
    "../../packages/auth/src",
    "../../packages/config/src",
    "../../packages/theme/src",
    "../../packages/storefront-preview/src",
    "../../packages/ui/src"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "../../packages/pricing/src/**/*.test.ts"
  ]
}
