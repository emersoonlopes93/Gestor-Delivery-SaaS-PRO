# -------------------------------------------------------------------------
# 1. API & WEBSOCKET CONNECTION
# -------------------------------------------------------------------------
# URL base de comunicação HTTP com o backend da API
VITE_API_URL="http://localhost:3333/api/v1"

# URL base para conexões em tempo real via WebSocket (Socket.IO) com a API (ex: painel de pedidos / inbox whatsapp)
# Deixe em branco se a API WebSocket rodar na mesma URL base HTTP (fallback automático)
VITE_WS_URL="http://localhost:3333"

# -------------------------------------------------------------------------
# 2. STOREFRONT REFERENCE
# -------------------------------------------------------------------------
# URL base do storefront do cliente para geração de QR Codes de mesa e links do cardápio (ex: http://localhost:5175 ou seu-subdominio.com)
VITE_STOREFRONT_BASE_URL="http://localhost:5175"
