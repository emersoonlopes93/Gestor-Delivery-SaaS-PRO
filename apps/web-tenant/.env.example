# =========================================================================
# GESTOR DELIVERY SAAS PRO - WEB-TENANT (PAINEL DO ESTABELECIMENTO / LOJISTA)
# =========================================================================

# -------------------------------------------------------------------------
# 1. API & WEBSOCKET CONNECTION
# -------------------------------------------------------------------------
# URL base de comunicação HTTP com o backend da API (com o prefixo /api/v1).
# ─────────────────────────────────────────────────────────────────────────
# DEV LOCAL   : VITE_API_URL pode ser omitida — o proxy Vite redireciona /api
#               automaticamente para http://localhost:3333 (ver vite.config.ts).
# APK ANDROID : DEVE ser uma URL absoluta HTTPS. O WebView do Capacitor não
#               passa pelo servidor de dev local e não usa o proxy Vite.
# ─────────────────────────────────────────────────────────────────────────
# Exemplos:
#   Dev local (sem proxy → backend local direto): http://localhost:3333/api/v1
#   Produção / APK Android                       : https://sua-api.onrender.com/api/v1
VITE_API_URL="http://localhost:3333/api/v1"
# Legacy fallback only; VITE_API_URL wins when both are configured.
# VITE_API_BASE_URL=

# URL base para conexões em tempo real via WebSocket (Socket.IO).
# Deixe sem o prefixo /api/v1 — o socket conecta na raiz do servidor.
# Exemplos:
#   Dev local  : http://localhost:3333
#   Produção   : https://sua-api.onrender.com
VITE_WS_URL="http://localhost:3333"

# -------------------------------------------------------------------------
# 2. STOREFRONT REFERENCE
# -------------------------------------------------------------------------
# URL base do storefront do cliente para geração de QR Codes de mesa e
# links do cardápio.
VITE_STOREFRONT_BASE_URL="http://localhost:3000"
VITE_GOOGLE_MAPS_KEY="your-google-maps-api-key"

# -------------------------------------------------------------------------
# 3. FEATURE FLAGS (desativadas por padrão — ative conforme necessário)
# -------------------------------------------------------------------------
VITE_FEATURE_AI_AGENT=false
VITE_FEATURE_WHATSAPP_CONNECT=false
VITE_FEATURE_ORDER_NOTIFICATIONS=true
VITE_FEATURE_CAMPAIGNS=false
VITE_FEATURE_CRM_ADVANCED=false
VITE_FEATURE_BI_ADVANCED=false
VITE_FEATURE_FRANCHISE=false
VITE_FEATURE_ADMIN_INTEGRATIONS=false
VITE_FEATURE_WHATSAPP_ADVANCED=false
VITE_FEATURE_DELIVERY_LIVE_MAP=false
VITE_FEATURE_INVENTORY_ADVANCED=false
VITE_FEATURE_FINANCE_ADVANCED=false
VITE_FEATURE_GOALS=false
VITE_FEATURE_UPSELLS=false

# -------------------------------------------------------------------------
# 4. DEBUG FLAGS (ativado apenas para desenvolvimento/debugging)
# -------------------------------------------------------------------------
# Quando true, exibe informações detalhadas de erro na tela (stack trace, etc.)
# IMPORTANTE: Deve ser false antes de entregar ao cliente em produção.
VITE_DEBUG_ERROR_BOUNDARY=false
