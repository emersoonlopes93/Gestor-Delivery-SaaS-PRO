{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client", "google.maps"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "rootDir": "../../",
    "paths": {
      "@/*": ["./src/*"],
      "@gestor/types": ["../../packages/types/src"],
      "@gestor/core": ["../../packages/core/src"],
      "@gestor/utils": ["../../packages/utils/src"],
      "@gestor/auth": ["../../packages/auth/src"],
      "@gestor/config": ["../../packages/config/src"],
      "@gestor/theme": ["../../packages/theme/src"],
      "@gestor/storefront-ui": ["../../packages/storefront-ui/src"],
      "@gestor/ui": ["../../packages/ui/src"]
    }
  },
  "include": [
    "src",
    "../../packages/types/src",
    "../../packages/core/src",
    "../../packages/utils/src",
    "../../packages/auth/src",
    "../../packages/config/src",
    "../../packages/theme/src",
    "../../packages/storefront-ui/src",
    "../../packages/ui/src"
  ]
}
