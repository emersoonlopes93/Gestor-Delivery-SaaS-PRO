{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://sudo-suspend-web-service-gestor-delivery.onrender.com/api/:path*" },
    { "source": "/manifest/:slug.webmanifest", "destination": "https://sudo-suspend-web-service-gestor-delivery.onrender.com/api/v1/public/storefront/:slug/manifest" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
