{
  "name": "@gestor/web-storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @gestor/pricing build",
    "dev": "vite --port 3000",
    "build": "tsc -b --noEmit && vite build",
    "test": "pnpm dlx vitest run --environment node --globals --passWithNoTests",
    "pretest": "pnpm --filter @gestor/pricing build",
    "cap:sync": "pnpm build && cap sync",
    "cap:android": "pnpm cap:sync && cap open android",
    "cap:ios": "pnpm cap:sync && cap open ios",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server.js"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.0",
    "@capacitor/camera": "^7.0.2",
    "@capacitor/core": "^7.4.4",
    "@capacitor/geolocation": "^7.1.5",
    "@capacitor/ios": "^7.4.4",
    "@capacitor/push-notifications": "^7.0.3",
    "@capacitor/share": "^7.0.2",
    "@gestor/core": "workspace:*",
    "@gestor/pricing": "workspace:*",
    "@gestor/types": "workspace:*",
    "@gestor/utils": "workspace:^",
    "@tanstack/react-query": "^5.60.0",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "0.453.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "4.2.1",
    "react-router-dom": "^6.28.0",
    "reflect-metadata": "^0.2.0",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@eslint/js": "^8.57.0",
    "@types/google.maps": "^3.64.0",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "globals": "^15.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.5.0",
    "typescript-eslint": "^7.7.0",
    "vite": "^5.4.10"
  }
}
