# =========================================================================
# GESTOR DELIVERY SAAS PRO - WEB-STOREFRONT (CARDÁPIO / LOJA VIRTUAL)
# =========================================================================

# -------------------------------------------------------------------------
# 1. API CONNECTION
# -------------------------------------------------------------------------
# URL base de comunicação com o backend da API (ex: http://localhost:3333/api/v1 ou na nuvem)
VITE_API_URL="http://localhost:3333/api/v1"
# Legacy fallback only; VITE_API_URL wins when both are configured.
# VITE_API_BASE_URL=

# Client ID público OAuth usado pelo Google Identity Services. O botão fica oculto sem esta configuração.
VITE_GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"

# -------------------------------------------------------------------------
# 2. GOOGLE MAPS INTEGRATION
# -------------------------------------------------------------------------
# Chave de API pública do Google Maps utilizada no frontend para autocompletar endereços e mapas interativos
VITE_GOOGLE_MAPS_KEY="your-google-maps-api-key"

# -------------------------------------------------------------------------
# 3. TENANT / DASHBOARD URL
# -------------------------------------------------------------------------
# URL para onde o sistema vai redirecionar após o lojista criar conta / acessar painel
VITE_TENANT_URL="http://localhost:5173"
