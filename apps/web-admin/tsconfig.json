{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "outDir": "./dist",
    "rootDir": "../../",
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@gestor/types": ["../../packages/types/src"],
      "@gestor/core": ["../../packages/core/src"],
      "@gestor/utils": ["../../packages/utils/src"],
      "@gestor/auth": ["../../packages/auth/src"],
      "@gestor/config": ["../../packages/config/src"],
      "@gestor/ui": ["../../packages/ui/src"]
    }
  },
  "include": [
    "src",
    "../../packages/types/src",
    "../../packages/core/src",
    "../../packages/utils/src",
    "../../packages/auth/src",
    "../../packages/config/src",
    "../../packages/ui/src"
  ],
  "exclude": ["node_modules", "dist"]
}
