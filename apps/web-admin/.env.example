# GESTOR DELIVERY SAAS PRO - WEB-ADMIN (PAINEL SUPER ADMINISTRADOR / SAAS)
# =========================================================================

# NOTA: Por padrão, o painel do super admin utiliza URLs relativas (/api/v1)
# e redireciona requisições locais via proxy configurado no vite.config.ts.
# Caso queira forçar uma URL de API customizada em produção, você pode definir aqui:

# URL base opcional de comunicação HTTP com o backend da API
# VITE_API_URL="http://localhost:3333/api/v1"
# Legacy fallback only; VITE_API_URL wins when both are configured.
# VITE_API_BASE_URL=
