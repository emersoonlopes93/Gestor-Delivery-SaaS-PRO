# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestor_delivery?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# App
API_PORT=3333
API_PREFIX="/api/v1"
NODE_ENV="development"

# Frontend URLs
WEB_TENANT_URL="http://localhost:5173"
WEB_ADMIN_URL="http://localhost:5174"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
WEB_STOREFRONT_URL="http://localhost:5175"

# CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175"

# Rate limiting
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_AUTH_TTL_SECONDS=60
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_PUBLIC_TTL_SECONDS=60
RATE_LIMIT_PUBLIC_MAX_REQUESTS=60

# Swagger
SWAGGER_ENABLED="false"
SWAGGER_PATH="/docs"

# Google Maps (Frontend — Storefront)
VITE_GOOGLE_MAPS_KEY="your-google-maps-api-key"
VITE_API_URL="http://localhost:3333/api/v1"

# WhatsApp Cloud API (Customer OTP)
WHATSAPP_CLOUD_ACCESS_TOKEN=""
WHATSAPP_CLOUD_PHONE_NUMBER_ID=""
WHATSAPP_CLOUD_GRAPH_API_VERSION="v19.0"
WHATSAPP_OTP_MESSAGE_TEMPLATE="Seu código de acesso é: {{CODE}}"
