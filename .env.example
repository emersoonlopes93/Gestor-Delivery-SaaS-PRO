# =========================================================================
# 1. CONFIGURAÇÕES PARA DESENVOLVIMENTO LOCAL (LOCALHOST / DOCKER)
# =========================================================================

# Database Local
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestor_delivery?schema=public"

# JWT (Mínimo 16 caracteres)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# App
API_PORT=3333
API_PREFIX="/api/v1"
NODE_ENV="development"

# Frontend URLs locais
WEB_TENANT_URL="http://localhost:5173"
WEB_ADMIN_URL="http://localhost:5174"
WEB_STOREFRONT_URL="http://localhost:5175"

# Redis Local (Sem TLS)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_TLS="false"

# Driver de Armazenamento Local
STORAGE_DRIVER="local"

# CORS Local
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175"

# Swagger
SWAGGER_ENABLED="false"
SWAGGER_PATH="/docs"

# Vercel / Frontend Env (Locais)
VITE_API_URL="http://localhost:3333/api/v1"
VITE_GOOGLE_MAPS_KEY="your-google-maps-api-key"

# WhatsApp Cloud API (Locais)
WHATSAPP_CLOUD_ACCESS_TOKEN=""
WHATSAPP_CLOUD_PHONE_NUMBER_ID=""
WHATSAPP_CLOUD_GRAPH_API_VERSION="v19.0"
WHATSAPP_OTP_MESSAGE_TEMPLATE="Seu código de acesso é: {{CODE}}"


# =========================================================================
# 2. CONFIGURAÇÕES OBRIGATÓRIAS PARA PRODUÇÃO (DEPLOY RENDER, VERCEL & R2)
# =========================================================================

# NOTA: Em produção (NODE_ENV=production), os validadores da API exigem a
# presença destas credenciais e barram a inicialização caso estejam ausentes/incorretas.

# Database Produção (Ex: Supabase, Neon)
# DATABASE_URL="postgresql://user:password@hostname:port/dbname?sslmode=require"

# JWT Produção (Mínimo 16 caracteres, obrigatório)
# JWT_SECRET="sua-chave-secreta-jwt-de-producao-longa-e-segura"
# JWT_REFRESH_SECRET="sua-outra-chave-secreta-refresh-de-producao-longa-e-segura"

# Redis de Produção (Ex: Upstash, Redis Cloud)
# REDIS_HOST="seu-redis.upstash.io"
# REDIS_PORT=31310
# REDIS_PASSWORD="sua-senha-do-redis"
# REDIS_TLS="true"   # Define como true para conexões seguras exigidas na nuvem

# Driver de Armazenamento de Produção (Obrigatório R2)
# STORAGE_DRIVER="r2"

# Cloudflare R2 (API S3 Compatível, obrigatório em produção)
# R2_ACCOUNT_ID="seu-account-id-cloudflare"
# R2_ACCESS_KEY_ID="sua-access-key-id-do-token-r2"
# R2_SECRET_ACCESS_KEY="sua-secret-access-key-do-token-r2"
# R2_BUCKET="seu-nome-de-bucket-r2"
# R2_PUBLIC_BASE_URL="https://seu-subdominio-customizado.com" # Ou domínio público do bucket no R2
# R2_REGION="auto"

# CORS de Produção (Domínios finais autorizados, separados por vírgula)
# CORS_ORIGINS="https://app.seudominio.com,https://admin.seudominio.com,https://loja.seudominio.com"

# Frontends na Vercel (Configurar no painel da Vercel)
# VITE_API_URL="https://sua-api.onrender.com/api/v1"  # Aponta para a API no Render
# VITE_STOREFRONT_BASE_URL="https://loja.seudominio.com"
