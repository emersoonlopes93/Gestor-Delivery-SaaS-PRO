{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "VITE_API_URL",
    "VITE_GOOGLE_MAPS_KEY",
    "VITE_TENANT_URL",
    "VITE_FEATURE_AI_AGENT",
    "VITE_FEATURE_CAMPAIGNS",
    "VITE_FEATURE_CRM_ADVANCED",
    "VITE_FEATURE_BI_ADVANCED",
    "VITE_FEATURE_FRANCHISE",
    "VITE_FEATURE_ADMIN_INTEGRATIONS",
    "VITE_FEATURE_WHATSAPP_ADVANCED",
    "VITE_FEATURE_DELIVERY_LIVE_MAP",
    "VITE_FEATURE_INVENTORY_ADVANCED",
    "VITE_FEATURE_FINANCE_ADVANCED",
    "VITE_FEATURE_GOALS",
    "VITE_FEATURE_UPSELLS",
    "VITE_FEATURE_WHATSAPP_CONNECT",
    "VITE_FEATURE_ORDER_NOTIFICATIONS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
