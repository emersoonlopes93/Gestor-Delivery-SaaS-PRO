# Stage 1: Base
FROM node:20-alpine AS base
RUN npm i -g pnpm
WORKDIR /app

# Stage 2: Dependencies
FROM base AS dependencies
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json turbo.json* ./
COPY apps/ ./apps/
COPY packages/ ./packages/
RUN pnpm install --frozen-lockfile

# Stage 3: Build
FROM dependencies AS build
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN pnpm --filter @gestor/web-storefront build

# Stage 4: Production (Node.js)
FROM node:20-alpine AS production
WORKDIR /app

# Copy built files
COPY --from=build /app/apps/web-storefront/dist ./dist
COPY --from=build /app/apps/web-storefront/server.js ./
COPY --from=build /app/apps/web-storefront/package.json ./

# Install only production dependencies for the server.js (express, dotenv)
RUN npm install express dotenv

EXPOSE 3000
CMD ["node", "server.js"]
